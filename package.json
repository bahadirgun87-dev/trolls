{
  "name": "voice-communication-app",
  "version": "1.0.0",
  "description": "Discord-like voice communication application with lossless audio, screen sharing, and chat features",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:client\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client && electron-builder",
    "build:client": "cd client && npm run build",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "voice",
    "communication",
    "webrtc",
    "electron",
    "desktop",
    "chat",
    "screen-sharing"
  ],
  "author": "Voice Comm Inc.",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.4",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.3.11",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.voicecomm.app",
    "productName": "Voice Communication App",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voicecomm/voice-app.git"
  }
}
